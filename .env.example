# AcadRisk AI Environment Configuration
SECRET_KEY=acadrisk-ai-super-secret-key-2026-production
FLASK_ENV=development
FLASK_DEBUG=0

# MySQL 8 Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=acadrisk_db
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/acadrisk_db

# Fallback Configuration (activated when MySQL 8 is unreachable)
ENABLE_FALLBACK=true
FALLBACK_SQLITE_URL=sqlite:///acadrisk_fallback.db

# Storage Paths
UPLOAD_FOLDER=uploads
MODEL_FOLDER=trained_models
BACKUP_FOLDER=backups

# Risk Calculation Thresholds (Percentages)
HIGH_RISK_THRESHOLD=40.0
MEDIUM_RISK_THRESHOLD=60.0

